{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/ies-effort-calculator/browser",
  "devCommand": "npm start",
  "installCommand": "npm install",
  "framework": "angular",
  "rewrites": [
    { "source": "/api/nominatim/(.*)", "destination": "https://nominatim.openstreetmap.org/$1" },
    { "source": "/api/osrm/(.*)", "destination": "https://router.project-osrm.org/$1" },
    { "source": "/api/val/(.*)", "destination": "https://ceice.gva.es/$1" },
    { "source": "/api/clm/(.*)", "destination": "https://educacion.castillalamancha.es/$1" },
    { "source": "/api/can/(.*)", "destination": "https://www.gobiernodecanarias.org/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
