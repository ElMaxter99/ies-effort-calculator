{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/ies-effort-calculator/browser",
  "devCommand": "npm start",
  "installCommand": "npm install",
  "framework": "angular",
  "rewrites": [
    { "source": "/api/nominatim/(.*)", "destination": "https://nominatim.openstreetmap.org/$1" },
    { "source": "/api/osrm/(.*)", "destination": "https://router.project-osrm.org/$1" },
    { "source": "/api/val/(.*)", "destination": "/api/proxy?region=val&path=$1" },
    { "source": "/api/clm/(.*)", "destination": "/api/proxy?region=clm&path=$1" },
    { "source": "/api/can/(.*)", "destination": "/api/proxy?region=can&path=$1" },
    { "source": "/api/cyl/(.*)", "destination": "/api/proxy?region=cyl&path=$1" },
    { "source": "/api/mad/(.*)", "destination": "/api/proxy?region=mad&path=$1" },
    { "source": "/api/cnt/(.*)", "destination": "/api/proxy?region=cnt&path=$1" },
    { "source": "/api/ast/(.*)", "destination": "/api/proxy?region=ast&path=$1" },
    { "source": "/api/nav/(.*)", "destination": "/api/proxy?region=nav&path=$1" },
    { "source": "/api/ext/(.*)", "destination": "/api/proxy?region=ext&path=$1" },
    { "source": "/api/mel/(.*)", "destination": "/api/proxy?region=mel&path=$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
